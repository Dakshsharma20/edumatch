# ---------- Public (safe to expose to the browser) ----------
NEXT_PUBLIC_APP_NAME=EduMatch
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# ---------- Database: MongoDB (Atlas free tier works) ----------
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/
MONGODB_URI=
MONGODB_DB=edumatch

# ---------- Stage 3: Razorpay (use TEST keys first) ----------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# SERVER ONLY.
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Stage 3: Transactional email ----------
# SERVER ONLY.
EMAIL_API_KEY=
EMAIL_FROM=

# ---------- Portals without a database ----------
# Portals render as open demo previews only in development. In production they return 404 unless this is "true".
# NEVER enable in a real deployment: it disables authorization.
EDUMATCH_PREVIEW_MODE=false

# ---------- Stage 3: lead export links ----------
# SERVER ONLY. Long random string (e.g. `openssl rand -hex 32`) used to sign 15-minute download links.
LEAD_EXPORT_SECRET=
